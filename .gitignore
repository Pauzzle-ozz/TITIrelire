# ---------------------------------------------------------------------------
# Generic .gitignore — will be tightened to the chosen stack.
# ---------------------------------------------------------------------------

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editors / IDEs
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets.*

# Logs
*.log
logs/

# Dependencies & build artifacts (common across ecosystems)
node_modules/
dist/
build/
out/
target/
bin/
obj/
coverage/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Temp
tmp/
temp/
*.tmp
